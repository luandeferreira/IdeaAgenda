# ============================================================
# IdeaAgenda — copie para .env e preencha:  cp .env.example .env
# ============================================================

# ---------- Geral ----------
ENVIRONMENT=production
APP_PORT=8080
# URL pública do frontend (usada no redirecionamento após o login com Google)
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:4200

# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# E-mails dos donos/administradores (separados por vírgula).
# Se vazio, o primeiro usuário que fizer login vira o dono.
ADMIN_EMAILS=

# Login sem Google (apenas para desenvolvimento/testes!)
ALLOW_DEV_LOGIN=false

# ---------- Banco de dados (PostgreSQL) ----------
POSTGRES_DB=ideaagenda
POSTGRES_USER=ideaagenda
POSTGRES_PASSWORD=ideaagenda

# ---------- Logs (Redis Streams) ----------
LOG_LEVEL=INFO
LOG_STREAM_KEY=ideaagenda:logs
LOG_MAX_ENTRIES=20000

# ---------- Google OAuth + Google Agenda ----------
# Console: https://console.cloud.google.com/apis/credentials (OAuth client "Aplicativo da Web")
# Ative a "Google Calendar API" no projeto e cadastre o URI de redirecionamento abaixo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
GOOGLE_CALENDAR_ID=primary
DEFAULT_TIMEZONE=America/Sao_Paulo

# ---------- Inteligência Artificial ----------
# Provedor padrão: openai | gemini  (o dono pode trocar a qualquer momento no "Painel do dono")
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Limite de chamadas de IA por usuário por hora (0 = sem limite)
AI_RATE_LIMIT_PER_HOUR=30
